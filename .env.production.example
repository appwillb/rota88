# =====================================================================
# VARIAVEIS DE AMBIENTE - FLEETBASE NO COOLIFY
# =====================================================================

# Seguranca e URLs Publicas
ENVIRONMENT=production
APP_NAME=Fleetbase
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api-fleet.seudominio.com
SESSION_DOMAIN=.seudominio.com

# Banco de Dados (Gerar senhas seguras no Coolify)
DB_ROOT_PASSWORD=sua_senha_root_super_segura_aqui
DB_USERNAME=fleetbase_user
DB_PASSWORD=sua_senha_usuario_super_segura_aqui
DB_DATABASE=fleetbase

# Cache & Filas (Redis)
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# Servico de WebSockets em Tempo Real
BROADCAST_DRIVER=socketcluster
SOCKETCLUSTER_HOST=socket-fleet.seudominio.com
SOCKETCLUSTER_PORT=443
SOCKETCLUSTER_SECURE=true

# Servico de Mapas e Roteamento
# Por padrao usa OSRM (Open Source gratuito). 
# Para maior precisao no Brasil, pode adicionar chave Google Maps futuramente:
OSRM_HOST=https://router.project-osrm.org
GOOGLE_MAPS_LOCALE=pt-BR
# GOOGLE_MAPS_API_KEY=sua_chave_aqui

# Configuracao de Envio de E-mails (SMTP)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=sua_chave_sendgrid
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=nao-responda@seudominio.com
# MAIL_FROM_NAME="Fleetbase Brasil"
