APP_NAME=Fleetbase
APP_ENV=production
APP_DEBUG=false
APP_URL=http://api.82.29.62.95.sslip.io

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
